# Generates vp_checker_build_info.h at *build* time (not configure time) so the
# timestamp reflects the actual build and the git commit is always current.
#
# Invoked by CMakeLists.txt as:
#   cmake -DOUTPUT=<file> -DVERSION_NAME=<name> -DVERSION_CODE=<code>
#         -DREPO_ROOT=<dir> -P gen_build_info.cmake
#
# The header is only rewritten when its content changes, so an unchanged
# version/commit does not force a relink; the timestamp will differ between
# builds by design.

if (NOT OUTPUT OR NOT REPO_ROOT)
    message(FATAL_ERROR "gen_build_info.cmake requires -DOUTPUT and -DREPO_ROOT")
endif()
if (NOT VERSION_NAME)
    set(VERSION_NAME "0.0.0")
endif()
if (NOT VERSION_CODE)
    set(VERSION_CODE 0)
endif()

string(TIMESTAMP BUILD_TIME_UTC "%Y-%m-%d %H:%M UTC" UTC)

set(GIT_COMMIT "unknown")
set(GIT_DIRTY 0)
find_program(GIT_EXECUTABLE git)
if (GIT_EXECUTABLE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${REPO_ROOT}" rev-parse --short=9 HEAD
        OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _rc ERROR_QUIET)
    if (_rc EQUAL 0 AND _sha)
        set(GIT_COMMIT "${_sha}")
        # Only the app's own sources count towards "dirty" so unrelated repo edits do not flag the build.
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${REPO_ROOT}" status --porcelain --untracked-files=no -- android/profiles-checker scripts profiles
            OUTPUT_VARIABLE _status OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE _rc2 ERROR_QUIET)
        if (_rc2 EQUAL 0 AND _status)
            set(GIT_DIRTY 1)
        endif()
    endif()
endif()

set(_content "// Generated by gen_build_info.cmake - do not edit.
#pragma once

#define VP_CHECKER_VERSION_NAME   \"${VERSION_NAME}\"
#define VP_CHECKER_VERSION_CODE   ${VERSION_CODE}
#define VP_CHECKER_BUILD_TIME_UTC \"${BUILD_TIME_UTC}\"
#define VP_CHECKER_GIT_COMMIT     \"${GIT_COMMIT}\"
#define VP_CHECKER_GIT_DIRTY      ${GIT_DIRTY}
")

file(WRITE "${OUTPUT}.tmp" "${_content}")
configure_file("${OUTPUT}.tmp" "${OUTPUT}" COPYONLY)   # copies only if different
file(REMOVE "${OUTPUT}.tmp")
