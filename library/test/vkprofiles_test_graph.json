{
    "$schema": "https://schema.khronos.org/vulkan/profiles-graph.json#",
    "nodes": [
        {
            "id": "desktop_max_2024",
            "description": "Combine Desktop Max 2024 profile for testing",
            "command": "combine",
            "args": {
                "input": "profiles/LunarG/VP_LUNARG_desktop_max_2024",
                "output": "profiles/test/data/VP_LUNARG_desktop_max_2024.json",
                "profile-name": "VP_LUNARG_desktop_max_2024",
                "profile-label": "LunarG Vulkan Desktop Max 2024 profile",
                "profile-desc": "A profile generated by the intersection of a collection of GPUInfo.org device reports to support the latest AMD, Intel and NVIDIA GPUs and drivers.",
                "profile-date": "2023-11-01",
                "profile-stage": "BETA",
                "profile-api-version": "1.3.244",
                "format": "flatten"
            }
        },
        {
            "id": "desktop_max_2026",
            "description": "Combine Desktop Max 2026 profile for testing",
            "command": "combine",
            "args": {
                "input": "profiles/LunarG/VP_LUNARG_desktop_max_2026",
                "output": "profiles/test/data/VP_LUNARG_desktop_max_2026.json",
                "profile-name": "VP_LUNARG_desktop_max_2026",
                "profile-label": "LunarG Vulkan Desktop Max 2026 profile",
                "profile-desc": "A profile generated by the intersection of a collection of GPUInfo.org device reports to support the latest AMD, Intel and NVIDIA GPUs and drivers.",
                "profile-date": "2026-06-22",
                "profile-stage": "BETA",
                "profile-api-version": "1.4.353",
                "format": "flatten"
            }
        },
        {
            "id": "library_test_roadmap",
            "description": "Generate Roadmap test library headers/source (Release)",
            "command": "library",
            "args": {
                "input": "profiles/build",
                "input-profiles": "VP_KHR_roadmap_2022,VP_KHR_roadmap_2024,VP_KHR_roadmap_2026",
                "output": "library/test",
                "output-src": "library/test",
                "output-filename": "generated_vulkan_profiles_roadmap",
                "mode": [ "header+source" ],
                "strip": true,
                "include-header": "generated_vulkan_profiles_roadmap.h",
                "config": "release"
            }
        },
        {
            "id": "library_test_roadmap_debug",
            "description": "Generate Roadmap test library headers/source (Debug)",
            "command": "library",
            "args": {
                "input": "profiles/build",
                "input-profiles": "VP_KHR_roadmap_2022,VP_KHR_roadmap_2024,VP_KHR_roadmap_2026",
                "output": "library/test",
                "output-src": "library/test",
                "output-filename": "generated_vulkan_profiles_roadmap_debug",
                "mode": [ "header+source" ],
                "strip": false,
                "include-header": "generated_vulkan_profiles_roadmap_debug.h",
                "config": "debug"
            }
        },
        {
            "id": "library_minimum_requirements",
            "description": "Generate Vulkan Minimum Requirements test library (Debug)",
            "command": "library",
            "args": {
                "input": "profiles/build",
                "input-profiles": "VP_LUNARG_minimum_requirements_1_0,VP_LUNARG_minimum_requirements_1_1,VP_LUNARG_minimum_requirements_1_2,VP_LUNARG_minimum_requirements_1_3,VP_LUNARG_minimum_requirements_1_4",
                "output": "library/test",
                "output-src": "library/test",
                "output-filename": "generated_vulkan_requirements_debug",
                "mode": [ "header+source" ],
                "strip": true,
                "include-header": "generated_vulkan_requirements_debug.h",
                "config": "debug"
            }
        },
        {
            "id": "library_test_release",
            "description": "Generate general test library headers/source (Release)",
            "command": "library",
            "args": {
                "input": "profiles",
                "input-profiles": "VP_KHR_roadmap_2022,VP_ANDROID_baseline_2021,VP_ANDROID_baseline_2022",
                "output": "library/test",
                "output-filename": "generated_vulkan_profiles",
                "mode": [ "header+source" ],
                "include-header": "generated_vulkan_profiles.h",
                "strip": true,
                "config": "release"
            }
        },
        {
            "id": "library_test_debug",
            "description": "Generate general test library headers/source (Debug)",
            "command": "library",
            "args": {
                "input": "profiles",
                "input-profiles": "VP_KHR_roadmap_2022,VP_ANDROID_baseline_2021,VP_ANDROID_baseline_2022",
                "output": "library/test",
                "output-filename": "generated_vulkan_profiles_debug",
                "mode": [ "header+source" ],
                "include-header": "generated_vulkan_profiles_debug.h",
                "strip": true,
                "config": "debug"
            }
        },
        {
            "id": "library_test_android",
            "description": "Generate Android test library headers/source",
            "command": "library",
            "args": {
                "input": "profiles/Android",
                "input-profiles": "VP_ANDROID_vulkan_profile_2021,VP_ANDROID_vulkan_profile_2022,VP_ANDROID_vulkan_profile_2025",
                "output": "library/test",
                "output-src": "library/test",
                "output-filename": "generated_vulkan_profiles_android",
                "mode": [ "header+source" ],
                "strip": true,
                "include-header": "generated_vulkan_profiles_android.h",
                "config": "release"
            }
        }
    ]
