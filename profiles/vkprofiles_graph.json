{
    "$schema": "https://schema.khronos.org/vulkan/profiles-graph.json#",
    "nodes": [
        {
            "id": "generate_schema",
            "description": "Generate Vulkan JSON Schema",
            "command": "schema",
            "args": {
                "output": "schema/profiles-0.8-latest.json",
                "api": "vulkan"
            }
        },
        {
            "id": "desktop_baseline",
            "description": "Combine Desktop Baseline multi-profile JSON",
            "depends_on": [ "generate_schema" ],
            "command": "combine",
            "args": {
                "output": "profiles/build/VP_LUNARG_desktop_baseline.json",
                "format": "flatten",
                "contributors": {
                    "Christophe Riccio": {
                        "company": "LunarG",
                        "email": "christophe@lunarg.com",
                        "contact": true
                    }
                },
                "history": [
                    {
                        "revision": 4,
                        "date": "2026-09-16",
                        "author": "Christophe Riccio",
                        "comment": "Updated Desktop Baseline profiles with missing structures"
                    },
                    {
                        "revision": 3,
                        "date": "2026-06-22",
                        "author": "Christophe Riccio",
                        "comment": "Add Desktop Baseline 2026 with Vulkan 1.4 requirement"
                    },
                    {
                        "revision": 2,
                        "date": "2024-02-21",
                        "author": "Christophe Riccio",
                        "comment": "Updated Desktop Baseline 2023 and 2022 to version 2 with ARC support"
                    },
                    {
                        "revision": 1,
                        "date": "2024-02-21",
                        "author": "Christophe Riccio",
                        "comment": "Merged Desktop Baseline 2024, 2023 and 2022 into a single file"
                    }
                ],
                "profiles": {
                    "VP_LUNARG_desktop_baseline_2022": {
                        "version": 3,
                        "input": "profiles/LunarG/VP_LUNARG_desktop_baseline_2022",
                        "label": "LunarG Vulkan Desktop Baseline 2022 profile",
                        "description": "A profile generated by the intersection of a collection of GPUInfo.org device reports to support a large number of actual systems in the Vulkan ecosystem. This profile is meant to be a usage example for Vulkan application developer.",
                        "date": "2026-09-16",
                        "stage": "STABLE",
                        "api-version": "1.1.139",
                        "required-profiles": ""
                    },
                    "VP_LUNARG_desktop_baseline_2023": {
                        "version": 3,
                        "input": "profiles/LunarG/VP_LUNARG_desktop_baseline_2023",
                        "label": "LunarG Vulkan Desktop Baseline 2023 profile",
                        "description": "A profile generated by the intersection of a collection of GPUInfo.org device reports to support a large number of actual systems in the Vulkan ecosystem. This profile is meant to be a usage example for Vulkan application developer.",
                        "date": "2026-09-16",
                        "stage": "STABLE",
                        "api-version": "1.2.148",
                        "required-profiles": ""
                    },
                    "VP_LUNARG_desktop_baseline_2024": {
                        "version": 2,
                        "input": "profiles/LunarG/VP_LUNARG_desktop_baseline_2024",
                        "label": "LunarG Vulkan Desktop Baseline 2024 profile",
                        "description": "A profile generated by the intersection of a collection of GPUInfo.org device reports to support a large number of actual systems in the Vulkan ecosystem. This profile is meant to be a usage example for Vulkan application developer.",
                        "date": "2026-09-16",
                        "stage": "STABLE",
                        "api-version": "1.2.204",
                        "required-profiles": ""
                    },
                    "VP_LUNARG_desktop_baseline_2026": {
                        "version": 2,
                        "input": "profiles/LunarG/VP_LUNARG_desktop_baseline_2026",
                        "label": "LunarG Vulkan Desktop Baseline 2026 profile",
                        "description": "A profile generated by the intersection of a collection of GPUInfo.org device reports to support a large number of actual systems in the Vulkan ecosystem. This profile is meant to be a usage example for Vulkan application developer.",
                        "date": "2026-09-16",
                        "stage": "STABLE",
                        "api-version": "1.4.303",
                        "required-profiles": ""
                    }
                }
            }
        },
        {
            "id": "transform_android",
            "description": "Transform Android profiles",
            "depends_on": [ "generate_schema" ],
            "command": "transform",
            "args": {
                "input": "profiles/Android",
                "output": "profiles/build",
                "pull": [ "required-capabilities", "aliases" ],
                "strip": [ "helper-values" ],
                "format": "flatten"
            }
        },
        {
            "id": "validate_profiles",
            "description": "Validate generated profiles against JSON Schema",
            "depends_on": [ "desktop_baseline", "transform_android" ],
            "command": "validate",
            "args": {
                "input": "profiles/build",
                "mode": [ "schema" ]
            }
        },
        {
            "id": "min_api_version_desktop",
            "description": "Evaluate and assign minimum API and schema versions for Desktop Baseline profiles",
            "depends_on": [ "validate_profiles" ],
            "command": "min-api-version",
            "args": {
                "input": "profiles/build/VP_LUNARG_desktop_baseline.json",
                "output": "profiles/build/VP_LUNARG_desktop_baseline.json",
                "mode": "evaluate",
                "format": "flatten"
            }
        },
        {
            "id": "library_release",
            "description": "Generate Vulkan Profiles C++ library (Release)",
            "depends_on": [ "min_api_version_desktop" ],
            "command": "library",
            "args": {
                "input": "profiles/build",
                "input_profiles": "VP_KHR_roadmap_2022,VP_KHR_roadmap_2024,VP_KHR_roadmap_2026,VP_LUNARG_desktop_baseline_2022,VP_LUNARG_desktop_baseline_2023,VP_LUNARG_desktop_baseline_2024,VP_LUNARG_desktop_baseline_2026",
                "output": "library/include/vulkan",
                "output_src": "library/source",
                "output_filename": "vulkan_profiles",
                "intermediate": "library/include/vulkan/intermediate",
                "mode": [ "header+source" ],
                "strip": true,
                "config": "release"
            }
        },
        {
            "id": "library_debug",
            "description": "Generate Vulkan Profiles C++ library (Debug)",
            "depends_on": [ "min_api_version_desktop" ],
            "command": "library",
            "args": {
                "input": "profiles/build",
                "input_profiles": "VP_KHR_roadmap_2022,VP_KHR_roadmap_2024,VP_KHR_roadmap_2026,VP_LUNARG_desktop_baseline_2022,VP_LUNARG_desktop_baseline_2023,VP_LUNARG_desktop_baseline_2024,VP_LUNARG_desktop_baseline_2026",
                "output": "library/include/vulkan/debug",
                "output_src": "library/source/debug",
                "output_filename": "vulkan_profiles",
                "mode": [ "header-only" ],
                "strip": true,
                "config": "debug"
            }
        },
        {
            "id": "library_android_release",
            "description": "Generate Android Vulkan Profiles header (Release)",
            "depends_on": [ "validate_profiles" ],
            "command": "library",
            "args": {
                "input": "profiles/build",
                "input_profiles": "VP_ANDROID_vulkan_profile_2021,VP_ANDROID_vulkan_profile_2022,VP_ANDROID_vulkan_profile_2025",
                "output": "library/include/vulkan",
                "output_filename": "android_vulkan_profiles",
                "mode": [ "header-only" ],
                "strip": true,
                "config": "release"
            }
        },
        {
            "id": "library_android_debug",
            "description": "Generate Android Vulkan Profiles header (Debug)",
            "depends_on": [ "validate_profiles" ],
            "command": "library",
            "args": {
                "input": "profiles/build",
                "input_profiles": "VP_ANDROID_vulkan_profile_2021,VP_ANDROID_vulkan_profile_2022,VP_ANDROID_vulkan_profile_2025",
                "output": "library/include/vulkan",
                "output_filename": "android_vulkan_profiles_debug",
                "mode": [ "header-only" ],
                "strip": true,
                "config": "debug"
            }
        },
        {
            "id": "doc_summary",
            "description": "Generate PROFILES.md documentation",
            "depends_on": [ "validate_profiles" ],
            "command": "doc",
            "args": {
                "input": "profiles/build",
                "input_profiles": "VP_KHR_roadmap_2022,VP_KHR_roadmap_2024,VP_KHR_roadmap_2026",
                "output": "PROFILES.md"
            }
        },
        {
            "id": "doc_desktop",
            "description": "Generate PROFILES_DESKTOP.md documentation",
            "depends_on": [ "min_api_version_desktop" ],
            "command": "doc",
            "args": {
                "input": "profiles/build",
                "input_profiles": "VP_LUNARG_desktop_baseline_2022,VP_LUNARG_desktop_baseline_2023,VP_LUNARG_desktop_baseline_2024,VP_LUNARG_desktop_baseline_2026",
                "output": "PROFILES_DESKTOP.md"
            }
        },
        {
            "id": "doc_android",
            "description": "Generate PROFILES_ANDROID.md documentation",
            "depends_on": [ "transform_android" ],
            "command": "doc",
            "args": {
                "input": "profiles/build",
                "input_profiles": "VP_ANDROID_vulkan_profile_2021,VP_ANDROID_vulkan_profile_2022,VP_ANDROID_vulkan_profile_2025",
                "output": "PROFILES_ANDROID.md"
            }
        },
        {
            "id": "summary_build",
            "description": "Print summary report of profiles in build directory",
            "depends_on": [ "doc_summary", "doc_desktop", "doc_android" ],
            "command": "summary",
            "args": {
                "input": "profiles/build"
            }
        }
    ]
}